# Copy to .env (gitignored).
#
# Heckler is strictly bring-your-own-key: the server holds NO LLM provider keys. Every run is paid
# for by the evaluator key saved on the agent. Do not put OPENROUTER_API_KEY / ANTHROPIC_API_KEY here;
# nothing reads them.

# --- prefills for the agent form's evaluator section (users still paste their own key) ---
# HECKLER_SUGGESTED_EVALUATOR_BASE_URL=https://openrouter.ai/api/v1
# HECKLER_SUGGESTED_EVALUATOR_MODEL=anthropic/claude-opus-5.5
# HECKLER_SUGGESTED_SCENARIO_MODEL=google/gemini-3.8-flash

# --- auth (Clerk). Leave unset to run as a single local user with no sign-in. ---
# Same key as VITE_CLERK_PUBLISHABLE_KEY in web/.env.local (Clerk dashboard -> API keys).
# HECKLER_CLERK_PUBLISHABLE_KEY=pk_test_...
# Web origins allowed to use a session token (comma-separated). Recommended.
# HECKLER_CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# --- misc ---
# HECKLER_DATA_DIR=data
# HECKLER_CORS_ORIGINS=http://localhost:5173
