# Copy to .env (gitignored). Only the keys for providers you actually use are needed.

# --- provider keys (conventional names, no prefix) ---
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- attacker agents A/B/C: provider = openrouter | anthropic | openai | fake ---
HECKLER_ATTACKER_PROVIDER=openrouter
HECKLER_ATTACKER_MODEL=anthropic/claude-sonnet-4.6
# Native Anthropic instead of OpenRouter:
# HECKLER_ATTACKER_PROVIDER=anthropic
# HECKLER_ATTACKER_MODEL=claude-opus-5-5
# HECKLER_ANTHROPIC_EFFORT=medium

# --- Simula scenario generation (cheap + fast is fine) ---
HECKLER_SIMULA_PROVIDER=openrouter
HECKLER_SIMULA_STRATEGIC_MODEL=google/gemini-3.8-flash
HECKLER_SIMULA_BULK_MODEL=google/gemini-3.8-flash
HECKLER_SIMULA_CRITIC_MODEL=google/gemini-3.8-flash

# --- fully offline demo mode (no keys, scripted models) ---
# HECKLER_ATTACKER_PROVIDER=fake
# HECKLER_SIMULA_PROVIDER=fake

# --- misc ---
# HECKLER_DATA_DIR=data
# HECKLER_CORS_ORIGINS=http://localhost:5173
